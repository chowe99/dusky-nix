#!/usr/bin/env bash
# nix-search - Interactive fuzzy search for nixpkgs
# Type to search, results stream in as nix evaluates.
# Enter=run package | Ctrl-S=nix shell | Ctrl-Y=copy name

# Pipeline to clean nix search output:
# 1. Parse nix search format (join name + description lines)
# 2. Strip ANSI codes from nix search (avoids regex issues with highlighted chars)
# 3. Strip legacyPackages.<arch>. prefix
# 4. Extract package set categories with color
# 5. Sort exact matches to top
CLEAN='sed -u -n '"'"'/^\*/{s/^\* //;N;s/\n  / — /;p}'"'"' | sed -u '"'"'
  s/\x1b\[[0-9;]*m//g
  s/legacyPackages\.[^.]*\.//
  s/^python[0-9]*Packages\./\x1b[32m[python]\x1b[0m /
  s/^typstPackages\./\x1b[36m[typst]\x1b[0m /
  s/^haskellPackages\./\x1b[35m[haskell]\x1b[0m /
  s/^linuxPackages_[^.]*\./\x1b[31m[kernel]\x1b[0m /
  s/^linuxKernel\.packages\.[^.]*\./\x1b[31m[kernel]\x1b[0m /
  s/^dwarf-fortress-packages\.themes\./\x1b[34m[dwarf-fortress]\x1b[0m /
  s/^\([a-z][a-z]*\)Packages\./\x1b[34m[\1]\x1b[0m /
'"'"''

# Helper to extract package name from a selected fzf line
extract_pkg() {
  local selected="$1"
  local pkg first_word category name
  first_word=$(echo "$selected" | awk '{print $1}' | sed 's/\x1b\[[0-9;]*m//g')
  if [[ "$first_word" == "["* ]]; then
    category=$(echo "$selected" | sed 's/\x1b\[[0-9;]*m//g; s/^\[\([^]]*\)\].*/\1/')
    name=$(echo "$selected" | sed 's/\x1b\[[0-9;]*m//g; s/^\[[^]]*\] *\([^ ]*\).*/\1/')
    case "$category" in
      python)  pkg="python3Packages.$name" ;;
      dwarf-fortress) pkg="dwarf-fortress-packages.themes.$name" ;;
      *)       pkg="${category}Packages.$name" ;;
    esac
  else
    pkg=$(echo "$selected" | sed 's/\x1b\[[0-9;]*m//g' | awk '{print $1}')
  fi
  echo "$pkg"
}

# Loop so the user can run multiple packages from one session
while true; do
  result=$(
    echo "Type to search nixpkgs..." | \
    fzf --ansi --disabled \
      --prompt="nixpkgs> " \
      --header="Enter=run | Ctrl-S=nix shell | Ctrl-Y=copy name" \
      --expect="ctrl-s,ctrl-y" \
      --bind 'change:reload:Q={q}; nix search nixpkgs "$Q" 2>/dev/null | '"$CLEAN"' | awk -v q="$Q" '"'"'
        /^[[:space:]]*$/ { next }
        {
          line = $0
          plain = line
          gsub(/\x1b\[[0-9;]*m/, "", plain)
          has_cat = match(plain, /^\[/)
          name = plain
          if (has_cat) sub(/^\[[^]]*\] */, "", name)
          sub(/ .*/, "", name)
          if (name == q && has_cat == 0) score = 0
          else if (name == q) score = 1
          else if (index(name, q) == 1 && has_cat == 0) score = 2
          else if (index(name, q) == 1) score = 3
          else if (has_cat == 0) score = 4
          else score = 5
          print score "\t" line
        }
      '"'"' | sort -t"	" -k1,1n -s | cut -f2- || true'
  )

  [ -z "$result" ] && exit 0

  key=$(echo "$result" | head -1)
  selected=$(echo "$result" | tail -n +2)
  [ -z "$selected" ] && exit 0

  pkg=$(extract_pkg "$selected")

  case "$key" in
    ctrl-s)
      bin=$(echo "$pkg" | sed 's/.*\.//')
      if command -v "$bin" &>/dev/null; then
        echo -e "\033[33m$pkg is already available in your environment.\033[0m"
        echo "Press Enter to close."
        read -r
      else
        echo "Opening shell with $pkg..."
        exec nix shell "nixpkgs#$pkg"
      fi
      ;;
    ctrl-y)
      echo -n "$pkg" | wl-copy
      notify-send "nix-search" "Copied '$pkg' to clipboard" 2>/dev/null
      # Loop back to fzf
      ;;
    *)
      echo -e "\033[36mRunning $pkg in background...\033[0m"
      # Build visibly in a new terminal, fully detached from nix-search
      setsid uwsm-app -- xdg-terminal-exec --title="nix-build: $pkg" bash -c "
        LOG=/tmp/nix-search-run-\$\$.log
        echo -e '\033[36mBuilding $pkg...\033[0m'
        if ! nix build --no-link 'nixpkgs#$pkg'; then
          echo -e '\033[31mBuild failed.\033[0m'
          echo 'Press Enter to close.'
          read -r
          exit 1
        fi
        echo -e '\033[32mDone! Launching $pkg...\033[0m'
        # Launch in a new session so it survives this terminal closing
        setsid nix run 'nixpkgs#$pkg' >\"\$LOG\" 2>&1 &
        RUN_PID=\$!
        sleep 2
        if kill -0 \$RUN_PID 2>/dev/null; then
          exit 0
        else
          wait \$RUN_PID 2>/dev/null
          EXIT_CODE=\$?
          if [ \$EXIT_CODE -ne 0 ]; then
            echo -e '\033[31mFailed to launch $pkg (exit code \$EXIT_CODE):\033[0m'
            cat \"\$LOG\"
            rm -f \"\$LOG\"
            echo
            echo 'Press Enter to close.'
            read -r
          fi
        fi
        rm -f \"\$LOG\"
      " &>/dev/null &
      # Loop back to fzf for more
      ;;
  esac
done
